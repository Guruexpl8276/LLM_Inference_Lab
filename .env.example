# ─────────────────────────────────────────────────────────────────────
#  LLM Inference Lab — environment configuration
#  Copy this file to .env and edit the values you care about.
#  Every variable is optional; sane defaults are baked in.
# ─────────────────────────────────────────────────────────────────────

# ── API server ──────────────────────────────────────────────────────
# Bind address and port for the FastAPI server.
API_HOST=127.0.0.1
API_PORT=8000

# ── Ollama ──────────────────────────────────────────────────────────
# Where the Ollama daemon is reachable (default is local).
OLLAMA_HOST=http://localhost:11434

# Default model used when /chat or /generate omits a model field.
DEFAULT_MODEL=llama3.2:3b

# Optional: store Ollama's model blobs in a custom location.
# Useful if your C: drive is small. Example:
#   OLLAMA_MODELS=D:\ollama_models
#   OLLAMA_MODELS=/mnt/data/ollama_models
# OLLAMA_MODELS=

# How many transformer layers Ollama should offload to GPU.
# 99 = "all layers" (recommended on any CUDA GPU). Set to 0 for CPU-only.
OLLAMA_NUM_GPU=99

# Per-request context window. Larger = more KV-cache VRAM.
# 2048 is safe for 4 GB cards; raise to 4096/8192 on 8 GB+ cards.
OLLAMA_NUM_CTX=2048

# ── Scheduler / backpressure ───────────────────────────────────────
# Hard ceiling on simultaneous in-flight inference requests.
MAX_CONCURRENT=6

# Capacity fraction at which the SJF queue starts injecting throttle delays.
SOFT_LIMIT_PCT=0.50

# Capacity fraction at which new requests are rejected with HTTP 429.
HARD_LIMIT_PCT=0.80

# VRAM % above which the server unconditionally sheds load (returns 429).
VRAM_OOM_THRESHOLD_PCT=90.0

# ── Persistent research log ────────────────────────────────────────
# Path to the SQLite file that stores every inference run + load test.
# Default is ./inference_lab.db (project root). Override to keep it
# elsewhere (e.g. on a fast SSD or a separate data drive).
# INFERENCE_DB_PATH=./inference_lab.db

# ── Python venv override (used by run.ps1 / run.sh) ────────────────
# Default is ./.venv. Override if your venv lives elsewhere.
# VENV_PATH=./.venv
